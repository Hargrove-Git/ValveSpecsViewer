@inherits LayoutComponentBase

<div class="shell">
    <header class="shell-header">
        <a href="/" class="header-brand">
            <span class="brand-icon">◈</span>
            <div class="brand-text">
                <span class="brand-title">VALVESPECS</span>
                <span class="brand-sub">Critical Dimension Viewer</span>
            </div>
        </a>
        <div class="header-meta">
            <AuthorizeView>
                <Authorized>
                    <details class="nav-menu">
                        <summary>MENU</summary>
                        <div class="nav-menu-body">
                            <a class="nav-menu-link" href="/review">Review Dimensions</a>
                            <a class="nav-menu-link" href="/documents">Documents</a>
                            <a class="nav-menu-link" href="/decode">Look Up Model Number</a>
                            <a class="nav-menu-link" href="/build">Build Model Number</a>
                            <AuthorizeView Roles="Admin" Context="adminCtx">
                                <Authorized>
                                    <a class="nav-menu-link" href="/admin/users">Manage Users</a>
                                </Authorized>
                            </AuthorizeView>
                        </div>
                    </details>

                    <details class="user-menu">
                        <summary>
                            <svg class="user-icon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                                <path d="M12 12c2.7 0 4.9-2.2 4.9-4.9S14.7 2.2 12 2.2 7.1 4.4 7.1 7.1 9.3 12 12 12Zm0 2.5c-3.3 0-9.8 1.6-9.8 4.9v2.4h19.6v-2.4c0-3.3-6.5-4.9-9.8-4.9Z"/>
                            </svg>
                            <span class="header-user-name">@context.User.FindFirst("DisplayName")?.Value</span>
                            <span class="header-role">@context.User.FindFirst(System.Security.Claims.ClaimTypes.Role)?.Value</span>
                        </summary>
                        <div class="user-menu-body">
                            <a class="nav-menu-link" href="/account/change-password">Change Password</a>
                            <form method="post" action="/logout">
                                <button type="submit" class="header-logout">Sign Out</button>
                            </form>
                        </div>
                    </details>
                </Authorized>
            </AuthorizeView>
        </div>
    </header>

    <main class="shell-main">
        @Body
    </main>
</div>
