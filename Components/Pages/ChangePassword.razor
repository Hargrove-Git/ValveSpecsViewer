@page "/account/change-password"
@attribute [Authorize]
@rendermode InteractiveServer
@inject UserService Users

<PageTitle>Change Password — ValveSpecs</PageTitle>

<div class="login-shell">
    <div class="login-card">
        <div class="login-brand">
            <span class="brand-icon">◈</span>
            <span class="brand-title">CHANGE PASSWORD</span>
        </div>

        @if (_success)
        {
            <p class="password-success">Password updated.</p>
            <a class="btn-primary login-submit" href="/">Back to ValveSpecs</a>
        }
        else
        {
            <div class="field-group">
                <label class="field-label">Current Password</label>
                <input class="field-input" type="password" @bind="_currentPassword" @bind:event="oninput" />
            </div>
            <div class="field-group">
                <label class="field-label">New Password (min. 8 characters)</label>
                <input class="field-input" type="password" @bind="_newPassword" @bind:event="oninput" />
            </div>
            <div class="field-group">
                <label class="field-label">Confirm New Password</label>
                <input class="field-input" type="password" @bind="_confirmPassword" @bind:event="oninput" />
            </div>

            @if (!string.IsNullOrEmpty(_error))
            {
                <p class="login-error">@_error</p>
            }

            <button class="btn-primary login-submit" @onclick="Submit">Update Password</button>
        }
    </div>
</div>

@code {
    private string _currentPassword = "";
    private string _newPassword = "";
    private string _confirmPassword = "";
    private string? _error;
    private bool _success;

    [CascadingParameter]
    private Task<AuthenticationState>? AuthStateTask { get; set; }

    private async Task Submit()
    {
        _error = null;

        if (string.IsNullOrWhiteSpace(_currentPassword))
        {
            _error = "Enter your current password.";
            return;
        }
        if (_newPassword.Length < 8)
        {
            _error = "New password must be at least 8 characters.";
            return;
        }
        if (_newPassword != _confirmPassword)
        {
            _error = "New password and confirmation do not match.";
            return;
        }

        var username = AuthStateTask is not null
            ? (await AuthStateTask).User.Identity?.Name
            : null;
        if (username is null) return;

        var ok = await Users.ChangePasswordAsync(username, _currentPassword, _newPassword);
        if (!ok)
        {
            _error = "Current password is incorrect.";
            return;
        }

        _success = true;
    }
}
